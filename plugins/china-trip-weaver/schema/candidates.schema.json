{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://china-trip-weaver.local/schema/candidates-1.0.0.json",
  "title": "ChinaTripWeaver researched candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates_version", "pois", "lodgings", "claims", "unknowns"],
  "properties": {
    "candidates_version": {"const": "1.0.0"},
    "pois": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "trip.schema.json#/$defs/poi"}
    },
    "lodgings": {
      "type": "array",
      "items": {"$ref": "trip.schema.json#/$defs/lodging"}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "trip.schema.json#/$defs/claim"}
    },
    "unknowns": {
      "type": "array",
      "items": {"$ref": "trip.schema.json#/$defs/unknown"}
    }
  }
}
