{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://china-trip-weaver.local/schema/trip-1.0.0.json",
  "title": "ChinaTripWeaver Trip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trip_id",
    "revision",
    "mode",
    "request",
    "days",
    "transport_legs",
    "lodgings",
    "pois",
    "claims",
    "provider_health",
    "unknowns",
    "patches",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "trip_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "revision": {"$ref": "#/$defs/revision"},
    "mode": {"$ref": "#/$defs/dataMode"},
    "mock_notice": {"type": ["string", "null"], "minLength": 1},
    "request": {"$ref": "#/$defs/request"},
    "budget_ledger": {"$ref": "#/$defs/budgetLedger"},
    "transport_pricing": {"$ref": "#/$defs/transportPricing"},
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/day"}
    },
    "transport_legs": {
      "type": "array",
      "items": {"$ref": "#/$defs/transportLeg"}
    },
    "lodgings": {
      "description": "Selected stays emitted by current planners; the legacy lodging shape remains accepted for existing Trip documents.",
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/stay"},
          {"$ref": "#/$defs/lodging"}
        ]
      }
    },
    "pois": {
      "type": "array",
      "items": {"$ref": "#/$defs/poi"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "provider_health": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/providerHealth"}
    },
    "unknowns": {
      "type": "array",
      "items": {"$ref": "#/$defs/unknown"}
    },
    "patches": {
      "type": "array",
      "items": {"$ref": "#/$defs/patch"}
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "required": ["mode"],
        "properties": {"mode": {"const": "mock"}}
      },
      "then": {
        "required": ["mock_notice"],
        "properties": {"mock_notice": {"type": "string", "minLength": 1}}
      }
    },
    {
      "if": {
        "required": ["days"],
        "properties": {
          "days": {
            "items": {
              "required": ["stay_id"]
            }
          }
        }
      },
      "then": {
        "properties": {
          "lodgings": {
            "items": {"$ref": "#/$defs/stay"}
          }
        }
      }
    },
    {
      "if": {
        "required": ["request"],
        "properties": {
          "request": {"required": ["traveler_groups"]}
        }
      },
      "then": {
        "required": ["transport_pricing"],
        "properties": {
          "transport_legs": {
            "items": {"required": ["group_refs"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "dataMode": {
      "type": "string",
      "enum": ["live", "cached", "static", "mock"]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "idList": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
      "uniqueItems": true
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lng", "lat"],
      "properties": {
        "lng": {"type": "number", "minimum": -180, "maximum": 180},
        "lat": {"type": "number", "minimum": -90, "maximum": 90}
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_crs", "native", "wgs84", "gcj02", "conversion"],
      "properties": {
        "source_crs": {
          "type": "string",
          "enum": ["WGS84", "GCJ02", "BD09", "provider-unknown"]
        },
        "native": {"$ref": "#/$defs/point"},
        "wgs84": {
          "oneOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]
        },
        "gcj02": {
          "oneOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]
        },
        "conversion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "method",
            "version",
            "derived_fields",
            "converted_at",
            "accuracy_m"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["not-needed", "converted", "unavailable"]
            },
            "method": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "derived_fields": {
              "type": "array",
              "items": {"type": "string", "enum": ["wgs84", "gcj02"]},
              "uniqueItems": true
            },
            "converted_at": {"type": ["string", "null"], "format": "date-time"},
            "accuracy_m": {"type": ["number", "null"], "minimum": 0}
          }
        }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "price_type",
        "unit",
        "includes_taxes",
        "queried_at",
        "claim_id"
      ],
      "properties": {
        "amount": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "price_type": {
          "type": "string",
          "enum": ["live", "reference", "estimate", "verify-on-click", "unknown"]
        },
        "unit": {
          "type": "string",
          "enum": ["total", "per_person", "per_night", "from"]
        },
        "includes_taxes": {"type": ["boolean", "null"]},
        "queried_at": {"type": ["string", "null"], "format": "date-time"},
        "claim_id": {"type": ["string", "null"]}
      }
    },
    "costRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": ["number", "null"], "minimum": 0},
        "maximum": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "budgetItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "category",
        "price_type",
        "amount_min_cny",
        "amount_max_cny",
        "basis",
        "included_in_scheduler",
        "reason"
      ],
      "properties": {
        "ref_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["poi", "transport", "lodging"]},
        "price_type": {
          "type": ["string", "null"],
          "enum": ["live", "reference", "estimate", "verify-on-click", "unknown", null]
        },
        "amount_min_cny": {"type": ["number", "null"], "minimum": 0},
        "amount_max_cny": {"type": ["number", "null"], "minimum": 0},
        "basis": {"type": "string", "minLength": 1},
        "included_in_scheduler": {"type": "boolean"},
        "reason": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "budgetLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "budget_cny",
        "known_cost_cny",
        "remaining_known_budget_cny",
        "total_range_cny",
        "status",
        "items"
      ],
      "properties": {
        "currency": {"const": "CNY"},
        "budget_cny": {"type": ["number", "null"], "minimum": 0},
        "known_cost_cny": {"type": "number", "minimum": 0},
        "remaining_known_budget_cny": {"type": ["number", "null"]},
        "total_range_cny": {"$ref": "#/$defs/costRange"},
        "status": {
          "type": "string",
          "enum": ["within_budget", "over_budget", "incomplete", "unbudgeted"]
        },
        "items": {"type": "array", "items": {"$ref": "#/$defs/budgetItem"}}
      }
    },
    "transportGroupTotal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_ref", "travelers", "total_cny"],
      "properties": {
        "group_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "travelers": {"type": "integer", "minimum": 1, "maximum": 20},
        "total_cny": {"$ref": "#/$defs/costRange"}
      }
    },
    "transportPricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "group_totals", "party_total_cny"],
      "properties": {
        "currency": {"const": "CNY"},
        "group_totals": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/transportGroupTotal"}
        },
        "party_total_cny": {"$ref": "#/$defs/costRange"}
      }
    },
    "placeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "name", "city"],
      "properties": {
        "ref_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1}
      }
    },
    "clockWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_time", "end_time"],
      "properties": {
        "start_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
        "title": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "mealWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meal_type", "start_time", "end_time"],
      "properties": {
        "meal_type": {"type": "string", "enum": ["lunch", "dinner"]},
        "start_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end_time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "duration_minutes": {"type": "integer", "minimum": 1, "maximum": 240},
        "title": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "mobilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["senior"],
      "properties": {
        "senior": {"type": "boolean"},
        "age": {"type": "integer", "minimum": 0, "maximum": 120},
        "fitness_level": {"type": "string", "enum": ["limited", "average", "good"]},
        "fitness": {"type": "string", "enum": ["limited", "average", "good"]},
        "uses_wheelchair": {"type": "boolean"}
      }
    },
    "travelerGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "travelers", "origin"],
      "properties": {
        "group_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "travelers": {"type": "integer", "minimum": 1, "maximum": 20},
        "origin": {"$ref": "#/$defs/placeRef"},
        "mobility_profile": {"$ref": "#/$defs/mobilityProfile"}
      }
    },
    "meetingAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "meet_by"],
      "properties": {
        "location": {"$ref": "#/$defs/placeRef"},
        "meet_by": {"type": "string", "format": "date-time"},
        "buffer_minutes": {
          "description": "Required time between every group arrival and meet_by; defaults to 60 when omitted.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destinations",
        "start_date",
        "end_date",
        "budget_cny",
        "interests",
        "pace",
        "constraints",
        "assumptions",
        "locale",
        "pasted_notes"
      ],
      "oneOf": [
        {
          "required": ["origin", "travelers"],
          "properties": {
            "traveler_groups": {"type": "null"},
            "meeting_anchor": {"type": "null"}
          }
        },
        {"required": ["traveler_groups", "meeting_anchor"]}
      ],
      "properties": {
        "origin": {
          "oneOf": [{"$ref": "#/$defs/placeRef"}, {"type": "null"}]
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/placeRef"}
        },
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "travelers": {"type": "integer", "minimum": 1, "maximum": 20},
        "traveler_groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/travelerGroup"}
        },
        "meeting_anchor": {"$ref": "#/$defs/meetingAnchor"},
        "party": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adults"],
          "properties": {
            "adults": {"type": "integer", "minimum": 1, "maximum": 20},
            "children": {"type": "integer", "minimum": 0, "maximum": 20}
          }
        },
        "rooms": {"type": "integer", "minimum": 1, "maximum": 20},
        "adult_count": {"type": "integer", "minimum": 1, "maximum": 20},
        "occupancy": {"type": ["string", "null"], "maxLength": 500},
        "bed_config": {"type": ["string", "null"], "maxLength": 500},
        "parking_required": {"type": "boolean"},
        "cancellation_preference": {"type": ["string", "null"], "maxLength": 500},
        "budget_cny": {"type": ["number", "null"], "minimum": 0},
        "interests": {"$ref": "#/$defs/stringList"},
        "pace": {"type": "string", "enum": ["slow", "balanced", "full"]},
        "mobility_profile": {"$ref": "#/$defs/mobilityProfile"},
        "walking_tolerance_km": {"type": "number", "minimum": 0, "maximum": 50},
        "meal_windows": {
          "oneOf": [
            {
              "type": "array",
              "items": {"$ref": "#/$defs/mealWindow"},
              "maxItems": 2
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "lunch": {"$ref": "#/$defs/clockWindow"},
                "dinner": {"$ref": "#/$defs/clockWindow"}
              }
            }
          ]
        },
        "rest_windows": {
          "type": "array",
          "items": {"$ref": "#/$defs/clockWindow"},
          "maxItems": 6
        },
        "constraints": {"$ref": "#/$defs/stringList"},
        "assumptions": {"$ref": "#/$defs/stringList"},
        "locale": {"type": "string", "enum": ["zh-CN", "en"]},
        "pasted_notes": {"type": ["string", "null"], "maxLength": 20000}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "start_at",
        "end_at",
        "kind",
        "ref_id",
        "title",
        "locked",
        "status",
        "claim_ids"
      ],
      "properties": {
        "slot_id": {"type": "string", "minLength": 1},
        "start_at": {"type": "string", "format": "date-time"},
        "end_at": {"type": "string", "format": "date-time"},
        "kind": {
          "type": "string",
          "enum": ["poi", "meal", "lodging", "transport", "rest", "free", "checkin", "checkout"]
        },
        "ref_id": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "locked": {"type": "boolean"},
        "status": {
          "type": "string",
          "enum": ["scheduled", "tentative", "skipped", "unknown"]
        },
        "claim_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_id", "date", "city", "timezone", "slots"],
      "properties": {
        "day_id": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "city": {"type": "string", "minLength": 1},
        "stay_id": {
          "description": "Selected stay covering this overnight date, or null on the final non-overnight day. Optional only for legacy Trip documents.",
          "type": ["string", "null"],
          "minLength": 1
        },
        "timezone": {"const": "Asia/Shanghai"},
        "pace": {"type": "string", "enum": ["slow", "balanced", "full"]},
        "planned_walking_km": {"type": "number", "minimum": 0},
        "slots": {"type": "array", "items": {"$ref": "#/$defs/slot"}}
      }
    },
    "transportLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg_id",
        "travel_mode",
        "data_mode",
        "from_ref",
        "to_ref",
        "depart_at",
        "arrive_at",
        "duration_minutes",
        "provider",
        "service_number",
        "price",
        "booking_url",
        "claim_ids",
        "locked"
      ],
      "properties": {
        "leg_id": {"type": "string", "minLength": 1},
        "travel_mode": {
          "type": "string",
          "enum": ["rail", "flight", "walk", "transit", "drive", "ride", "taxi", "bus", "ferry"]
        },
        "data_mode": {"$ref": "#/$defs/dataMode"},
        "from_ref": {"type": "string", "minLength": 1},
        "to_ref": {"type": "string", "minLength": 1},
        "group_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
          "uniqueItems": true
        },
        "depart_at": {"type": ["string", "null"], "format": "date-time"},
        "arrive_at": {"type": ["string", "null"], "format": "date-time"},
        "duration_minutes": {"type": ["integer", "null"], "minimum": 0},
        "provider": {"type": ["string", "null"]},
        "service_number": {"type": ["string", "null"]},
        "price": {
          "oneOf": [{"$ref": "#/$defs/price"}, {"type": "null"}]
        },
        "booking_url": {
          "oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]
        },
        "claim_ids": {"$ref": "#/$defs/idList"},
        "locked": {"type": "boolean"}
      }
    },
    "lodging": {
      "description": "Researched lodging candidate shape retained for candidates.schema.json and legacy Trip compatibility.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lodging_id",
        "name",
        "city",
        "area",
        "check_in",
        "check_out",
        "coordinates",
        "price",
        "deep_links",
        "claim_ids",
        "locked"
      ],
      "properties": {
        "lodging_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "area": {"type": "string", "minLength": 1},
        "check_in": {"type": "string", "format": "date"},
        "check_out": {"type": "string", "format": "date"},
        "coordinates": {
          "oneOf": [{"$ref": "#/$defs/coordinates"}, {"type": "null"}]
        },
        "price": {
          "oneOf": [{"$ref": "#/$defs/price"}, {"type": "null"}]
        },
        "deep_links": {"type": "array", "items": {"$ref": "#/$defs/url"}},
        "claim_ids": {"$ref": "#/$defs/idList"},
        "locked": {"type": "boolean"}
      }
    },
    "stay": {
      "description": "A lodging candidate explicitly selected for one or more exact overnight dates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lodging_id",
        "candidate_ref",
        "selection_status",
        "selected_nights",
        "name",
        "city",
        "area",
        "check_in",
        "check_out",
        "coordinates",
        "price",
        "deep_links",
        "claim_ids",
        "locked"
      ],
      "properties": {
        "lodging_id": {"type": "string", "minLength": 1},
        "candidate_ref": {"type": "string", "minLength": 1},
        "selection_status": {"const": "selected"},
        "selected_nights": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        },
        "name": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "area": {"type": "string", "minLength": 1},
        "check_in": {"type": "string", "format": "date"},
        "check_out": {"type": "string", "format": "date"},
        "coordinates": {
          "oneOf": [{"$ref": "#/$defs/coordinates"}, {"type": "null"}]
        },
        "price": {
          "oneOf": [{"$ref": "#/$defs/price"}, {"type": "null"}]
        },
        "deep_links": {"type": "array", "items": {"$ref": "#/$defs/url"}},
        "claim_ids": {"$ref": "#/$defs/idList"},
        "locked": {"type": "boolean"}
      }
    },
    "openingWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_at", "end_at", "status", "claim_id"],
      "properties": {
        "start_at": {"type": "string", "format": "date-time"},
        "end_at": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "enum": ["verified", "tentative", "closed", "unknown"]},
        "claim_id": {"type": ["string", "null"]}
      }
    },
    "poi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poi_id",
        "name",
        "city",
        "category",
        "coordinates",
        "recommended_duration_minutes",
        "opening_windows",
        "price",
        "deep_links",
        "claim_ids"
      ],
      "properties": {
        "poi_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "coordinates": {
          "oneOf": [{"$ref": "#/$defs/coordinates"}, {"type": "null"}]
        },
        "recommended_duration_minutes": {"type": ["integer", "null"], "minimum": 0},
        "physical_intensity": {
          "type": "string",
          "enum": ["light", "moderate", "heavy"]
        },
        "opening_windows": {"type": "array", "items": {"$ref": "#/$defs/openingWindow"}},
        "price": {
          "oneOf": [{"$ref": "#/$defs/price"}, {"type": "null"}]
        },
        "deep_links": {"type": "array", "items": {"$ref": "#/$defs/url"}},
        "claim_ids": {"$ref": "#/$defs/idList"}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "subject_ref",
        "field_path",
        "value",
        "source_url",
        "provider",
        "queried_at",
        "status",
        "confidence",
        "mode",
        "as_of",
        "raw_ref",
        "response_hash",
        "json_path"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "subject_ref": {"type": "string", "minLength": 1},
        "field_path": {"type": "string", "pattern": "^/"},
        "value": {},
        "source_url": {"$ref": "#/$defs/url"},
        "provider": {"type": "string", "minLength": 1},
        "queried_at": {"type": "string", "format": "date-time"},
        "status": {
          "type": "string",
          "enum": ["verified", "partial", "hypothesis", "unknown", "stale", "conflict", "unavailable", "mock"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "mode": {"$ref": "#/$defs/dataMode"},
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "raw_ref": {"type": ["string", "null"]},
        "response_hash": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "json_path": {"type": ["string", "null"]}
      }
    },
    "providerHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "version", "mode", "status", "checked_at", "capabilities", "reason"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "mode": {"$ref": "#/$defs/dataMode"},
        "status": {
          "type": "string",
          "enum": ["ready", "missing", "expired", "forbidden", "rate_limited", "degraded", "unavailable", "contract_mismatch"]
        },
        "checked_at": {"type": "string", "format": "date-time"},
        "capabilities": {"$ref": "#/$defs/stringList"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "reason", "provider", "claim_id"],
      "properties": {
        "field_path": {"type": "string", "pattern": "^/"},
        "reason": {"type": "string", "minLength": 1},
        "provider": {"type": ["string", "null"]},
        "claim_id": {"type": ["string", "null"]}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "parent_revision", "created_at", "reason", "created_by"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "parent_revision": {"type": ["integer", "null"], "minimum": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "enum": ["system", "user"]}
      }
    },
    "patchOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": {"type": "string", "enum": ["add", "remove", "replace", "move", "copy", "test"]},
        "path": {"type": "string", "pattern": "^/"},
        "from": {"type": "string", "pattern": "^/"},
        "value": {}
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_id",
        "base_revision",
        "target_revision",
        "created_at",
        "trigger",
        "reason",
        "scope",
        "operations",
        "reverify_claim_ids",
        "stability"
      ],
      "properties": {
        "patch_id": {"type": "string", "minLength": 1},
        "base_revision": {"type": "integer", "minimum": 1},
        "target_revision": {"type": "integer", "minimum": 2},
        "created_at": {"type": "string", "format": "date-time"},
        "trigger": {
          "type": "string",
          "enum": ["user_edit", "disruption", "weather", "closure", "delay", "provider_change"]
        },
        "reason": {"type": "string", "minLength": 1},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["day_ids", "affected_refs", "locked_refs"],
          "properties": {
            "day_ids": {"$ref": "#/$defs/idList"},
            "affected_refs": {"$ref": "#/$defs/idList"},
            "locked_refs": {"$ref": "#/$defs/idList"}
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/patchOperation"}
        },
        "reverify_claim_ids": {"$ref": "#/$defs/idList"},
        "stability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preserved_refs", "changed_refs", "score"],
          "properties": {
            "preserved_refs": {"$ref": "#/$defs/idList"},
            "changed_refs": {"$ref": "#/$defs/idList"},
            "score": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    }
  }
}
